[
	{
		"_comment": "VOM compat for the ungraded ore blocktype. See ore-graded.json for the full mechanism (addmerge onto parent /textures; unqualified = game domain; Conquest rock cube base; Universal mod so it applies server-side).",
		"op": "addmerge",
		"file": "game:blocktypes/stone/ore-ungraded.json",
		"path": "/textures",
		"dependsOn": [ { "modid": "visibleoresandminerals" } ],
		"value": {
			"cube": {
				"base": "block/stone/rock/conquest/{rock}/sides/1",
				"overlays": [ "block/stone/ore/{type}1" ],
				"alternates": [
					{ "base": "block/stone/rock/conquest/{rock}/sides/1", "overlays": [ "block/stone/ore/{type}2" ] },
					{ "base": "block/stone/rock/conquest/{rock}/sides/1", "overlays": [ "block/stone/ore/{type}3" ] }
				]
			},
			"ore1ByType": {
				"*-flint-*": { "base": "block/stone/flint" },
				"*-alum-*": { "base": "item/resource/crushed/alum" },
				"*": { "base": "item/resource/ungraded/{type}" }
			}
		}
	}
]
