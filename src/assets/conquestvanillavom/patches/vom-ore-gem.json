[
	{
		"_comment": "VOM compat for the gem ore blocktype. See vom-ore-graded.json for the full mechanism. Gem lumps are the polished gem block texture (diamond/emerald/olivine), falling back to the ungraded ore item for the rest. Unqualified = game domain; Conquest rock cube base; Universal mod so it applies server-side.",
		"op": "addmerge",
		"file": "game:blocktypes/stone/ore-gem.json",
		"path": "/textures",
		"dependsOn": [ { "modid": "visibleoresandminerals" } ],
		"value": {
			"cube": {
				"base": "block/stone/rock/conquest/{rock}/sides/1",
				"overlays": [ "block/stone/ore/{type}1" ],
				"alternates": [
					{ "base": "block/stone/rock/conquest/{rock}/sides/1", "overlays": [ "block/stone/ore/{type}2" ] },
					{ "base": "block/stone/rock/conquest/{rock}/sides/1", "overlays": [ "block/stone/ore/{type}3" ] }
				]
			},
			"ore1ByType": {
				"*-diamond-*": { "base": "block/stone/gem/diamond" },
				"*-emerald-*": { "base": "block/stone/gem/emerald" },
				"*-olivine_peridot-*": { "base": "block/stone/gem/olivine" },
				"*": { "base": "item/resource/ungraded/{type}" }
			}
		}
	}
]
